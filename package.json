{
  "name": "ahwtna",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.1.0",
  "description": "قهوتنا | ahwtna — Egyptian Café Social Gaming Platform (Domino 101)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "npm run dev --workspace=@ahwtna/web",
    "dev:server": "npm run dev --workspace=@ahwtna/server",
    "play": "npm run build --workspace=@ahwtna/game-engine && node packages/game-engine/dist/cli-play.js",
    "build": "turbo run build",
    "start": "node apps/server/dist/standalone.js",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.2",
    "prettier": "^3.3.3"
  }
}
